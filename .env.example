# Set in your shell (setx on Windows). Never commit real keys.
# Guides: docs/gemini-api-key.ru.md, docs/openai-api-key.ru.md. Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional per-stage overrides (otherwise config.json). Providers: anthropic | openai | gemini
# CARDGEN_PLANNER_PROVIDER=openai
# CARDGEN_PLANNER_MODEL=gpt-5.6-terra
# CARDGEN_IMAGE_PROVIDER=gemini
# CARDGEN_IMAGE_MODEL=gemini-3-pro-image
# CARDGEN_QA_PROVIDER=gemini
# CARDGEN_QA_MODEL=gemini-3.8-flash

# Optional delay between image requests, ms
GEN_DELAY_MS=1500
